LAMMPS (22 Jul 2025 - Update 4)
include         ../common.mod
# ============================================================
# common.mod -- core settings shared by every LAMMPS script in
# this project. Include this FIRST, before create_box/read_data.
# ============================================================

units           metal
dimension       3
boundary        p p p
atom_style      atomic
atom_modify     map array

# Centralized here so every stage (quench, relax, tension) uses
# the same neighbor settings
neighbor        4.0 bin
neigh_modify    delay 0 every 1 check yes

# NOTE: Ttarget below is a placeholder (1000 K), not confirmed
# against the specific temperature used in the original Jang,
# Seol & Lee (2019) CALPHAD liquid-mixing assessment -- that
# number is buried in a figure in the paper and wasn't found via
# search. Check the paper directly and adjust before treating
# results as a real validation rather than a sanity check.
variable        Ttarget equal 1000.0
variable        xZn     equal 0.0
variable        xCa     equal 1.0
variable        tag     string "Ca"

lattice         fcc 4.5
Lattice spacing in x,y,z = 4.5 4.5 4.5
region          box block 0 12 0 12 0 12 units lattice   # 6912 atoms
create_box      3 box
Created orthogonal box = (0 0 0) to (54 54 54)
  1 by 2 by 2 MPI processor grid
create_atoms    1 box
Created 6912 atoms
  using lattice units in orthogonal box = (0 0 0) to (54 54 54)
  create_atoms CPU = 0.001 seconds

include         ../potential.mod
# ============================================================
# potential.mod -- shared interatomic potential definition.
#
# ORDERING REQUIREMENT: include this AFTER create_box or
# read_data, never before -- pair_coeff needs atom types 1/2/3
# to already exist. (This is why it's a separate file from
# common.mod, which is included at the very top of every script,
# before types exist in the melt-quench script.)
#
# STILL UNVERIFIED: the "Ca Zn Mg" / "Mg Zn Ca" element-order
# pairing below is what composition 1 has been running with
# throughout this project. The second list (Mg Zn Ca) correctly
# matches the mass assignments (Mg=1, Zn=2, Ca=3). The FIRST
# list's order needs to match however CaZnMg.meam internally
# indexes its ternary parameters, and that has never been
# independently confirmed -- run the Phase 1 pure-Mg cohesive
# energy / lattice constant check against this exact pair_style
# line before fully trusting downstream results.
# ============================================================

mass            1 24.305      # Mg
mass            2 65.38       # Zn
mass            3 40.078      # Ca

pair_style      hybrid/overlay meam zbl 1.0 2.0
pair_coeff      * * meam ../potentials/library.meam Ca Zn Mg ../potentials/CaZnMg.meam Mg Zn Ca
pair_coeff      1 1 zbl 12.0 12.0
pair_coeff      1 2 zbl 12.0 30.0
pair_coeff      1 3 zbl 12.0 20.0
pair_coeff      2 2 zbl 30.0 30.0
pair_coeff      2 3 zbl 30.0 20.0
pair_coeff      3 3 zbl 20.0 20.0

if "${xZn} > 0.0" then   "set type 1 type/fraction 2 ${xZn} 12345"
if "${xCa} > 0.0" then   "set type 1 type/fraction 3 $(v_xCa/(1.0-v_xZn)) 54321"
set type 1 type/fraction 3 $(v_xCa/(1.0-v_xZn)) 54321
set type 1 type/fraction 3 1 54321
Setting atom values ...
  6912 settings made for type/fraction

velocity        all create ${Ttarget} 9834 dist gaussian
velocity        all create 1000 9834 dist gaussian

fix             1 all npt temp ${Ttarget} ${Ttarget} 0.1 iso 0.0 0.0 1.0
fix             1 all npt temp 1000 ${Ttarget} 0.1 iso 0.0 0.0 1.0
fix             1 all npt temp 1000 1000 0.1 iso 0.0 0.0 1.0
timestep        0.001
thermo          2000
thermo_style    custom step temp pe press vol density
run             15000   # melt + equilibrate -- confirmed-safe length at 4 cores; grow only if you confirm more cores are actually granted
Neighbor list info ...
  update: every = 1 steps, delay = 0 steps, check = yes
  max neighbors/atom: 2000, page size: 100000
  master list distance cutoff = 10
  ghost atom cutoff = 10
  binsize = 5, bins = 11 11 11
  3 neighbor lists, perpetual/occasional/extra = 3 0 0
  (1) pair meam, perpetual
      attributes: full, newton on, cut 10
      pair build: full/bin/atomonly
      stencil: full/bin/3d
      bin: standard
  (2) pair meam, perpetual, half/full from (1)
      attributes: half, newton on
      pair build: halffull/newton
      stencil: none
      bin: none
  (3) pair zbl, perpetual, copy from (2)
      attributes: half, newton on
      pair build: copy
      stencil: none
      bin: none

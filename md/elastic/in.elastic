# ============================================================
# in.elastic
# Main driver: builds and relaxes the reference structure, then
# applies +/- small strain in each of 6 directions (Voigt xx, yy,
# zz, yz, xz, xy), measuring the resulting stress tensor each time
# to compute the full 6x6 Cij matrix via central difference.
#
# SIGN CONVENTION, stated explicitly since this is the single
# easiest thing to get backwards: LAMMPS reports PRESSURE (pxx,
# pyy, ...), and pressure = -stress in the usual mechanics
# convention used by the stress-strain relation sigma_i = Cij*eps_j.
# So Cij is computed as -(pressure_pos - pressure_neg)/(2*strain),
# not +(...). This flip is applied explicitly below, not left
# implicit.
#
# HONESTY NOTE: this was carefully constructed and logic-checked
# against the standard LAMMPS ELASTIC example, but NOT executed
# against a real LAMMPS binary (none available in the environment
# this was written in). Test on testq before trusting the result,
# and check the self-consistency markers below (positive diagonal
# Cii, Cij symmetry, hexagonal relation C66=(C11-C12)/2) before
# using these numbers anywhere.
# ============================================================

include init_elastic.mod

# ---- loop over the 6 strain directions ----
label loop_dir
variable dir loop 6

  # Defensive deletes before redefinition -- same rationale as
  # displace_elastic.mod: not independently verified against a real
  # LAMMPS binary, so remove any doubt about redefinition behavior.
  variable len0 delete
  variable len0 equal 1.0   # placeholder; only dir 1-3 branches below actually use it
  if "${dir} == 1" then "variable len0 delete" "variable len0 equal ${lx0}"
  if "${dir} == 2" then "variable len0 delete" "variable len0 equal ${ly0}"
  if "${dir} == 3" then "variable len0 delete" "variable len0 equal ${lz0}"

  variable updown delete
  variable updown equal 1
  include displace_elastic.mod
  variable pxx_p delete
  variable pyy_p delete
  variable pzz_p delete
  variable pyz_p delete
  variable pxz_p delete
  variable pxy_p delete
  variable pxx_p equal ${pxx1}
  variable pyy_p equal ${pyy1}
  variable pzz_p equal ${pzz1}
  variable pyz_p equal ${pyz1}
  variable pxz_p equal ${pxz1}
  variable pxy_p equal ${pxy1}

  variable updown delete
  variable updown equal -1
  include displace_elastic.mod
  variable pxx_n delete
  variable pyy_n delete
  variable pzz_n delete
  variable pyz_n delete
  variable pxz_n delete
  variable pxy_n delete
  variable pxx_n equal ${pxx1}
  variable pyy_n equal ${pyy1}
  variable pzz_n equal ${pzz1}
  variable pyz_n equal ${pyz1}
  variable pxz_n equal ${pxz1}
  variable pxy_n equal ${pxy1}

  # Central-difference Cij for this column (row i, this column = dir),
  # with the pressure->stress sign flip applied explicitly.
  # BUG FOUND from first real result: using v_pxx_p (a LIVE reference,
  # re-evaluated whenever the containing variable is read) instead of
  # ${pxx_p} (an IMMEDIATE substitution, frozen to a literal number at
  # the moment this line parses) meant every Cij formula silently
  # re-evaluated using whatever pxx_p/pxx_n happened to hold at FINAL
  # print time -- i.e. direction 6's values, for every single column.
  # Confirmed directly: every row of the first real result was
  # identical across all six columns except row 6 (the last
  # iteration, which happened to still hold correct values). Fixed by
  # switching every operand here to ${...} immediate substitution,
  # so each column's Cij is permanently baked in from that
  # direction's own measured stress, not a live pointer that changes
  # on later iterations.
  variable C1${dir} equal -(${pxx_p}-${pxx_n})/(2.0*${up})*${cfac}
  variable C2${dir} equal -(${pyy_p}-${pyy_n})/(2.0*${up})*${cfac}
  variable C3${dir} equal -(${pzz_p}-${pzz_n})/(2.0*${up})*${cfac}
  variable C4${dir} equal -(${pyz_p}-${pyz_n})/(2.0*${up})*${cfac}
  variable C5${dir} equal -(${pxz_p}-${pxz_n})/(2.0*${up})*${cfac}
  variable C6${dir} equal -(${pxy_p}-${pxy_n})/(2.0*${up})*${cfac}

  # NOTE: a per-column diagnostic print used to sit here, but it
  # required nested variable substitution (${C1${dir}}) to read back
  # a dynamically-named variable -- LAMMPS does not support this
  # (confirmed directly: "ERROR: Substitution for illegal variable
  # C1${dir" on first real test). Creating a variable with a computed
  # name (the six lines above) is a different, valid mechanism and is
  # unaffected. The final summary block below uses plain, non-nested
  # references (${C11}, ${C12}, etc.) and does not have this problem.
  print "Column ${dir} complete."

next dir
jump in.elastic loop_dir

# ---- report full matrix ----
print "================================================================"
print "ELASTIC CONSTANTS MATRIX (${cunits})"
print "C11=${C11} C12=${C12} C13=${C13} C14=${C14} C15=${C15} C16=${C16}"
print "C21=${C21} C22=${C22} C23=${C23} C24=${C24} C25=${C25} C26=${C26}"
print "C31=${C31} C32=${C32} C33=${C33} C34=${C34} C35=${C35} C36=${C36}"
print "C41=${C41} C42=${C42} C43=${C43} C44=${C44} C45=${C45} C46=${C46}"
print "C51=${C51} C52=${C52} C53=${C53} C54=${C54} C55=${C55} C56=${C56}"
print "C61=${C61} C62=${C62} C63=${C63} C64=${C64} C65=${C65} C66=${C66}"
print "================================================================"

# ---- self-consistency checks -- CHECK THESE BEFORE TRUSTING RESULTS ----
print "SELF-CHECK 1 (stability): C11, C22, C33, C44, C55, C66 must ALL be positive."
print "  C11=${C11} C22=${C22} C33=${C33} C44=${C44} C55=${C55} C66=${C66}"

variable c66_check equal (${C11}-${C12})/2.0
print "SELF-CHECK 2 (hexagonal symmetry, since this is HCP Mg): C66 should equal (C11-C12)/2."
print "  Computed C66=${C66}, (C11-C12)/2=${c66_check}"
print "  These should agree to within a few percent if the calculation ran correctly."

print "SELF-CHECK 3 (symmetry): Cij should equal Cji for all i,j (matrix should be symmetric)."
print "  Compare C12 vs C21 (${C12} vs ${C21}), C13 vs C31 (${C13} vs ${C31}), etc."

print "SELF-CHECK 4 (external reference): compare against NIST-computed values for this"
print "  potential family at a matching lattice constant (a0=3.209 Ang):"
print "  Reference: C11~63, C33~70, C12~25, C13~21, C44~17, C66~19 GPa"
print "  If our C11/C33/etc. differ from these by more than ~20-30%, investigate before trusting."

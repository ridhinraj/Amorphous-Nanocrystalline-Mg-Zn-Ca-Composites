print           "PHASE1_RESULT tag=${tag} xMg=$(1.0-v_xZn-v_xCa) xZn=${xZn} xCa=${xCa}"
PHASE1_RESULT tag=Mg xMg=1 xZn=0 xCa=0
print           "Mean PE/atom written to liquid_pe_${tag}.dat"
